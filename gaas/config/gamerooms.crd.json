{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "gamerooms.gaming.bingops.com"
  },
  "spec": {
    "group": "gaming.bingops.com",
    "scope": "Namespaced",
    "names": {
      "plural": "gamerooms",
      "singular": "gameroom",
      "kind": "GameRoom"
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        },
        "additionalPrinterColumns": [
          {
            "name": "Game",
            "type": "string",
            "jsonPath": ".spec.game"
          },
          {
            "name": "Version",
            "type": "string",
            "jsonPath": ".spec.version"
          },
          {
            "name": "Desired",
            "type": "string",
            "jsonPath": ".spec.state"
          },
          {
            "name": "Phase",
            "type": "string",
            "jsonPath": ".status.phase"
          },
          {
            "name": "Gateway",
            "type": "string",
            "jsonPath": ".spec.gatewayRef"
          }
        ],
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "properties": {
              "spec": {
                "type": "object",
                "required": [
                  "game",
                  "version",
                  "world",
                  "network",
                  "serverCredentialsSecretRef"
                ],
                "properties": {
                  "game": {
                    "type": "string",
                    "enum": [
                      "project-zomboid"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "Running",
                      "Suspended"
                    ],
                    "default": "Running"
                  },
                  "gatewayRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
                    "default": "shared"
                  },
                  "world": {
                    "type": "object",
                    "required": [
                      "id",
                      "repository",
                      "credentialsSecretRef",
                      "serverName"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
                        "x-kubernetes-validations": [
                          {
                            "rule": "self == oldSelf",
                            "message": "world.id is immutable; create another GameRoom for another world"
                          }
                        ]
                      },
                      "repository": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Restic repository URL without embedded credentials.",
                        "x-kubernetes-validations": [
                          {
                            "rule": "self == oldSelf",
                            "message": "World repository migration requires an explicit recovery workflow"
                          }
                        ]
                      },
                      "credentialsSecretRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                      },
                      "restoreSnapshot": {
                        "type": "string",
                        "minLength": 1,
                        "default": "latest"
                      },
                      "volumeClaimRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                      },
                      "serverName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-zA-Z0-9_-]+$",
                        "x-kubernetes-validations": [
                          {
                            "rule": "self == oldSelf",
                            "message": "The restored game server name is immutable"
                          }
                        ]
                      }
                    }
                  },
                  "serverCredentialsSecretRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "retryNonce": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "network": {
                    "type": "object",
                    "required": [
                      "targetIP",
                      "nodePorts",
                      "publicPorts"
                    ],
                    "properties": {
                      "targetIP": {
                        "type": "string",
                        "format": "ipv4"
                      },
                      "nodePorts": {
                        "type": "object",
                        "required": [
                          "game",
                          "direct"
                        ],
                        "properties": {
                          "game": {
                            "type": "integer",
                            "minimum": 30000,
                            "maximum": 32767
                          },
                          "direct": {
                            "type": "integer",
                            "minimum": 30000,
                            "maximum": 32767
                          }
                        },
                        "x-kubernetes-validations": [
                          {
                            "rule": "self.game != self.direct",
                            "message": "NodePorts must differ"
                          }
                        ]
                      },
                      "publicPorts": {
                        "type": "object",
                        "required": [
                          "game",
                          "direct"
                        ],
                        "properties": {
                          "game": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          },
                          "direct": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          }
                        },
                        "x-kubernetes-validations": [
                          {
                            "rule": "self.game != self.direct",
                            "message": "Public ports must differ"
                          }
                        ]
                      }
                    }
                  }
                }
              },
              "status": {
                "type": "object",
                "x-kubernetes-preserve-unknown-fields": true
              }
            }
          }
        }
      }
    ]
  }
}
