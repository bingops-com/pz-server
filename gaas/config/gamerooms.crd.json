{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "gamerooms.gaming.bingops.com"
  },
  "spec": {
    "group": "gaming.bingops.com",
    "scope": "Namespaced",
    "names": {
      "plural": "gamerooms",
      "singular": "gameroom",
      "kind": "GameRoom"
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        },
        "additionalPrinterColumns": [
          {
            "name": "Game",
            "type": "string",
            "jsonPath": ".spec.game"
          },
          {
            "name": "Version",
            "type": "string",
            "jsonPath": ".spec.version"
          },
          {
            "name": "Desired",
            "type": "string",
            "jsonPath": ".spec.state"
          },
          {
            "name": "Phase",
            "type": "string",
            "jsonPath": ".status.phase"
          },
          {
            "name": "Gateway",
            "type": "string",
            "jsonPath": ".spec.gatewayRef"
          }
        ],
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "properties": {
              "spec": {
                "type": "object",
                "required": [
                  "game",
                  "version",
                  "world"
                ],
                "properties": {
                  "game": {
                    "type": "string",
                    "enum": [
                      "project-zomboid"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "Running",
                      "Suspended"
                    ],
                    "default": "Running"
                  },
                  "gatewayRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
                    "default": "shared"
                  },
                  "world": {
                    "type": "object",
                    "required": [
                      "id",
                      "repository",
                      "credentialsSecretRef"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
                        "x-kubernetes-validations": [
                          {
                            "rule": "self == oldSelf",
                            "message": "world.id is immutable; create another GameRoom for another world"
                          }
                        ]
                      },
                      "repository": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Restic repository URL without embedded credentials."
                      },
                      "credentialsSecretRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                      },
                      "restoreSnapshot": {
                        "type": "string",
                        "minLength": 1,
                        "default": "latest"
                      },
                      "volumeClaimRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                      }
                    }
                  }
                }
              },
              "status": {
                "type": "object",
                "x-kubernetes-preserve-unknown-fields": true
              }
            }
          }
        }
      }
    ]
  }
}
